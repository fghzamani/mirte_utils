# ---------------------------------------------------------------------------
# Package sources are NOT tracked here.
#
# They live in their own repositories and are pinned by mirte_demo.repos:
#   vcs import src < mirte_demo.repos
#
# Tracking src/ would make git record each nested repository as a bare gitlink
# with no .gitmodules. The result looks complete, clones with an EMPTY src/,
# and silently loses everything.
# ---------------------------------------------------------------------------
src/

# colcon artefacts. Regenerated by `colcon build`, and root-owned because the
# container runs as root -- `git add` from the host would fail on them anyway.
build/
install/
log/

# Per-run artefacts: rosbag, one log per node, config snapshot. 600+ MB and
# growing. The config/ snapshot inside each run directory already records the
# parameters that produced it, so these are data, not source. Keep the ones you
# care about on lab storage.
logs/

__pycache__/
*.pyc
*.pyo
